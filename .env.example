# Copy this file to .env and set your local secrets before running the app.
# Only needed when distance.geocoding.provider: google or distance.use_google_maps_bike_calculation: true.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional runtime overrides for the API server
APT_FINDER_HOST=
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Optional launcher overrides for the all-in-one scripts
APT_FINDER_API_PORT=8000
APT_FINDER_WEB_PORT=5173

# Optional CORS override for local and LAN development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
